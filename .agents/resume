#!/usr/bin/env bash
# Entire's git hooks live in the orb's global hooks directory, which Amp also
# writes to, so reinstall them on every wake. Idempotent and chains existing hooks.
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
command -v entire >/dev/null 2>&1 || exit 0
cd "$(dirname "${BASH_SOURCE[0]}")/.."
entire enable </dev/null >/dev/null
